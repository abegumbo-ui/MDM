<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LockGuard.Setup</RootNamespace>
    <!-- No admin manifest: this talks to the service (which runs as SYSTEM and does all the
         privileged work) over the pipe, authenticated by the code -- it never touches the
         firewall or the service itself directly, so it doesn't need elevation. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockGuard.Common\LockGuard.Common.csproj" />
  </ItemGroup>

</Project>
