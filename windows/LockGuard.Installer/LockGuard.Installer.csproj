<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LockGuard.Installer</RootNamespace>
    <AssemblyName>LockGuard.Installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by CI (see .github/workflows/windows.yml) right before this project is
         published; not checked into the repo. Zips of the already-published Service and
         Setup apps, embedded here so the single published exe can lay both of them down on
         disk itself. Building this project directly (outside that CI step) fails until those
         two files exist. -->
    <EmbeddedResource Include="Resources\Service.zip" Condition="Exists('Resources\Service.zip')">
      <LogicalName>Service.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Setup.zip" Condition="Exists('Resources\Setup.zip')">
      <LogicalName>Setup.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
