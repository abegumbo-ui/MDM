<?xml version="1.0" encoding="utf-8"?>
<!-- requireAdministrator makes Windows show the UAC prompt and elevate before this process
     even starts, instead of the app re-launching itself after discovering it isn't elevated. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
