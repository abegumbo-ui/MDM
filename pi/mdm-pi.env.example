# Settings of the MDM server on the Pi: copy to /etc/mdm-pi.env (root only: chmod 600) and fill in.
# pi/deploy.ps1 makes this file for you, with random secrets.

# The password of this server's dashboard.
ADMIN_PASSWORD=change-me

# "main" on the Pi. (The Cloudflare copy has ROLE=backup.)
ROLE=main

# The address phones and the dashboard use for the Pi (https, no slash at the end), and the Cloudflare address (the backup).
# Both are handed to the phones at their next check-in. Leave PRIMARY_URL empty until the Pi has its public address.
PRIMARY_URL=
BACKUP_URL=https://mdm.example.workers.dev
PUBLIC_URL=

# A long random text, the same on the Pi and on Cloudflare: lets the two copy data between them.
REPLICA_SECRET=change-me-too

# Where the phone update (latest app) is looked up.
GITHUB_REPO=abegumbo-ui/MDM

PORT=8787
HOST=127.0.0.1
DATA_DIR=/var/lib/mdm-pi
