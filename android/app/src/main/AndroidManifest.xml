<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the Settings menu icon's Learn setup (Administrator -> Settings menu icon setup) see
         which screen was last open. A device owner gets this automatically on some phones, with no
         Settings prompt; declaring it here is still required either way. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Lets the separate Browser app (signed with this same key) talk to this agent. -->
    <permission
        android:name="com.familymdm.agent.permission.BROWSER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="MDM Agent"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdminActivity"
            android:exported="false" />

        <activity
            android:name=".AdminCodeActivity"
            android:exported="false" />

        <activity
            android:name=".CodeEntryActivity"
            android:exported="false" />

        <activity
            android:name=".UserActivity"
            android:exported="false" />

        <activity
            android:name=".LocalSettingsActivity"
            android:exported="false" />

        <!-- Shaped like the real Settings app, reached only from HomeActivity's own tile in Home
             screen mode now, not a separate icon in the regular launcher anymore. A distinct
             taskAffinity still keeps it its own entry in recents rather than joining MainActivity's
             task, same reasoning as when it was a second launcher icon. -->
        <activity
            android:name=".SettingsMenuActivity"
            android:exported="false"
            android:taskAffinity="com.familymdm.agent.settingsmenu" />

        <!-- The Browser add-on's own screen. Reached only through the BrowserAddon alias below;
             never launched directly, so it stays unexported. -->
        <activity
            android:name=".BrowserAddonActivity"
            android:exported="false" />

        <!-- The Browser add-on's own launcher icon, disabled by default, same package as this
             agent (not a second installed app), turned on only by the administrator from Add-ons
             (see AdminActivity.buildAddonsSection() and BrowserAddon.setEnabled()). An
             activity-alias instead of a separate APK: there's nothing to install, sign, or keep in
             sync, since it's already part of this same build. -->
        <activity-alias
            android:name=".BrowserAddon"
            android:targetActivity=".BrowserAddonActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Browser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Dialing *#*#636#*#* on the phone's own dialer ("MDM" on a keypad) brings the app icon
             back after "hideAppIcon" hid it, using the standard Android "secret code" mechanism.
             Exported on purpose: the system dialer sends this broadcast from outside the app. -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="636" />
            </intent-filter>
        </receiver>

        <!-- The separate Browser app reports a blocked page here. -->
        <receiver
            android:name=".SiteRequestReceiver"
            android:exported="true"
            android:permission="com.familymdm.agent.permission.BROWSER">
            <intent-filter>
                <action android:name="com.familymdm.agent.action.SITE_REQUEST" />
            </intent-filter>
        </receiver>

        <!-- The separate Browser app's offline master-code "allow this page" calls come through here. -->
        <provider
            android:name=".BrowserBridgeProvider"
            android:authorities="com.familymdm.agent.provider"
            android:exported="true"
            android:permission="com.familymdm.agent.permission.BROWSER" />

        <service
            android:name=".AgentService"
            android:exported="false" />

        <!-- Instant, recents-safe version of the blocklist bounce; see BlockAccessibilityService's
             own doc comment for why this exists alongside the UsageStatsManager polling in
             AppBlocklist rather than replacing it (it needs a manual one-time grant, so the poller
             stays as a fallback for whenever this hasn't been turned on). -->
        <service
            android:name=".BlockAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
