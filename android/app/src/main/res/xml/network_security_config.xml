<?xml version="1.0" encoding="utf-8"?>
<!--
  The YouTube icon and the Browser add-on (web views inside this app) must trust the phone's own
  inspection certificate, like Chrome and the Browser app do. Without it every page behind the proxy
  fails its certificate check and the screen stays blank.
  This app's own connections (the dashboard, update downloads) trust Android's built-in list only,
  so a certificate added to the phone cannot listen in on them.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">workers.dev</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
