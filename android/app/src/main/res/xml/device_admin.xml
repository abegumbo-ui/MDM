<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
    </uses-policies>
    <!-- Lets another device-owner app (e.g. Alliance Shield X's own "Transfer Owner" feature) hand
         device-owner status to this app via DevicePolicyManager.transferOwnership(); unlike
         set-device-owner, a transfer works even after the device's one-time provisioning window has
         closed, since Android treats it as an explicit owner-to-owner handoff, not fresh provisioning. -->
    <support-transfer-ownership />
</device-admin>
