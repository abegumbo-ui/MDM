<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
    </uses-policies>
    <!-- Lets the agent app hand device-owner status to this app via
         DevicePolicyManager.transferOwnership(), from its own "Transfer device owner" button,
         without a factory reset. -->
    <support-transfer-ownership />
</device-admin>
