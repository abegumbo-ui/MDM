<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The DNS/Network filter's own relay needs this to forward whatever it decides to let
         through (a non-blocked DNS query, an allowed TLS connection). Without it, those socket
         opens simply fail, so the filter would block all traffic, not just the configured list.
         This app still never talks to a server of its own; nothing here adds an address for it to
         reach or any code that would try. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the filter ask the OS which app owns a given connection, so the Traffic Log and
         Block Whole Network can tell them apart. Normal permission, granted automatically. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Only lets this app ask to uninstall a package. As the device owner, that request goes
         through silently with no confirmation dialog, for the bulk-list feature's best-effort
         real uninstall attempt (the block it applies alongside is what actually guarantees the
         outcome, this permission only covers the bonus on top of it). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".LockdownApplication"
        android:allowBackup="false"
        android:label="Lockdown Setup"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The permanent home screen once Close Forever has run. Excluded from recents since
             there's nothing to switch back to: it IS the home screen. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- This app's own in-app Settings menu, reached only from HomeActivity's own tile. Its own
             package keeps it hard-locked into the kiosk like HomeActivity, with no need to ever put
             the real Settings app in the lock task allowlist: see SettingsMenuActivity's own note. -->
        <activity
            android:name=".SettingsMenuActivity"
            android:exported="false" />

        <!-- Powers the "Notifications" soft-block picker: lets a package keep running (needed for
             Android Auto, which needs the Google app and GMS alive) while auto-dismissing any
             notification it tries to show. Only acts on packages checked there, and only while
             the Lockdown switch is on; see NotificationSuppressor's own note. -->
        <service
            android:name=".NotificationSuppressor"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The device's DNS blocklist, Block Whole Network, and TLS-SNI-aware traffic log, all in
             one VPN. See DnsFilterVpnService's own class doc for what it captures and the two
             independent layers (device-wide, then per-app) it checks. Only exists/runs while
             Lockdown is on and DnsBlocklist or NetworkBlocklist is non-empty. -->
        <service
            android:name=".DnsFilterVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
